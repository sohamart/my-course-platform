# Version control
.git
.gitignore

# Dependencies
node_modules
*/node_modules
backend/node_modules
frontend/node_modules

# Environment variables & secrets
.env
.env.local
.env.development
backend/.env
backend/.env.local
backend/.env.development
frontend/.env
frontend/.env.local
frontend/.env.development

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Test coverage & scripts
coverage
.nyc_output
scripts/verifyEndpoints.js

# Local user uploads (S3 is used for production; avoid copying local files)
backend/uploads/*
!backend/uploads/.gitkeep


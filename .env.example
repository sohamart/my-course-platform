# ==============================================================================
# MyCourse PLMS - Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Reverse Proxy Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Your production domain or EC2 Public IP / DNS (Used by Caddy for auto-HTTPS)
# Example: DOMAIN=courses.example.com  or  DOMAIN=your-ec2-ip.nip.io
DOMAIN=localhost

# Frontend client URL (used for CORS if accessing from an external origin)
CLIENT_URL=http://localhost

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Provide your MongoDB Atlas production connection string.
# NOTE: In production (NODE_ENV=production), the application requires a valid URI
# and will fail fast if unreachable (in-memory MongoDB is disabled in production).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mycourse?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Strong random secret key for JWT token signing (minimum 32 characters)
JWT_SECRET=replace_with_a_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Initial Administrator Seed Account
# ------------------------------------------------------------------------------
# Used when running 'docker compose exec app node utils/seedAdmin.js'
ADMIN_EMAIL=admin@mycourse.local
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=Headmaster Admin

# ------------------------------------------------------------------------------
# 5. AWS S3 Storage Configuration
# ------------------------------------------------------------------------------
# Set the region and private bucket name
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=mycourse-private-media-2026

# Disable local emulation in production so all media is stored on AWS S3
USE_LOCAL_S3_FALLBACK=false

# AWS IAM CREDENTIALS:
# On AWS EC2: When the IAM Instance Role 'MyCourseEC2S3Role' is attached to your EC2 instance,
# the AWS SDK automatically obtains credentials via the Default Credential Provider Chain.
# DO NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in production!
#
# (Only uncomment and set these for local development without an EC2 IAM role):
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key


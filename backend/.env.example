# ===================================================
# MyCourse - Backend Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or local fallback)
# Set your MongoDB Atlas connection string here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mycourse?retryWrites=true&w=majority
# If left blank or connection fails, the system automatically runs an in-memory/embedded MongoDB for seamless local development.

# JWT Authentication
JWT_SECRET=mycourse_super_secret_jwt_key_2026_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Admin Seed Credentials (Created via `npm run seed`)
ADMIN_EMAIL=admin@mycourse.local
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=Headmaster Admin

# AWS S3 Configuration (Private Storage)
# Set your real AWS credentials below for production (or leave empty on EC2 with IAM Instance Role):
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=mycourse-private-media-2026

# EC2 IAM Role support:
# If running on AWS EC2 with IAM Role 'MyCourseEC2S3Role' attached, AWS SDK automatically
# detects IAM instance profile credentials. Leave AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY blank.
# For local development with real AWS credentials:
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Local S3 Storage Emulation Mode:
# Set to 'false' in production. When set to 'true', MyCourse activates its
# built-in S3-compatible local storage engine for zero-setup offline development.
USE_LOCAL_S3_FALLBACK=false


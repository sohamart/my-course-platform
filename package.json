{
  "name": "mycourse-workspace",
  "version": "1.0.0",
  "description": "MyCourse - Personal Learning Management System",
  "scripts": {
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && node scripts/copyBuild.js",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "seed:demo": "npm run seed:demo --prefix backend",
    "test": "npm test --prefix backend",
    "start:backend": "npm run dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
